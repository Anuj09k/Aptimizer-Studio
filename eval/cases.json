{
  "about": "The assistant's test set: requests per mode, what each should do, and a reference answer that does it. Run with `aptimizer-studio eval` (see docs/assistant-test-set.md). Checks read the state Studio sends (AptCAD's drawing.inspect, AptBIM's inspect in brief) or, with `in`, a query's answer, before the request and after. `$state:PATH` in a reference answer is the before-state's value there.",
  "cases": [
    {
      "name": "cad-line",
      "mode": "cad",
      "request": "Draw a line from 0,0 to 100,50.",
      "checks": [
        {
          "grows": "counts.Line",
          "by": 1
        }
      ],
      "reference": [
        {
          "id": "line",
          "params": {
            "points": [
              [
                0,
                0
              ],
              [
                100,
                50
              ]
            ]
          }
        }
      ]
    },
